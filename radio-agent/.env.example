# 选择一种鉴权方式。真实凭证只填写到本地 .env，不要修改此示例文件。
# 新版语音控制台 API Key，需开通对应的实时语音服务：
VOLC_API_KEY=
# 或填写旧版语音控制台凭证，不是通用云 AK/SK：
VOLC_APP_ID=
VOLC_ACCESS_KEY=

# O2.0 支持由客户端判断说话结束（push_to_talk）。
VOLC_MODEL=1.2.1.1
VOLC_SPEAKER=zh_male_yunzhou_jupiter_bigtts
RADIO_TX_GAIN=0.75
RADIO_SILENCE_SECONDS=1.0
RADIO_VAD_MIN_DBFS=-42
RADIO_MAX_INPUT_SECONDS=30
RADIO_MAX_REPLY_SECONDS=20
RADIO_REPLY_TIMEOUT_SECONDS=45
RADIO_IDLE_RESET_SECONDS=300
RADIO_GUARD_SECONDS=0.4
# 相对路径以配置文件所在目录为基准，修改后请更新 Git 忽略规则。
RADIO_LOG_DIR=data
